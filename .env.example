DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-long-random-secret"
OTP_HASH_SECRET="replace-with-a-different-long-random-secret"
LOGIN_ALLOWED_EMAILS="reader@example.com"
# Optional in local development: when both values stay empty, login codes are printed to the terminal.
# Production still requires a Resend API key and a sender on a verified domain.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# Keep 0 for direct local development. Set the exact trusted reverse-proxy hop count in production.
TRUST_PROXY_HOPS="0"
# Production must use an absolute persistent-disk path, for example /srv/enjoy-english/data.
APP_DATA_DIR=""

# Optional: DeepSeek uses an OpenAI-compatible chat endpoint. Core reading works without it.
AI_API_KEY=""
AI_BASE_URL="https://api.deepseek.com"
AI_MODEL="deepseek-flash"
AI_PROVIDER="deepseek"
AI_DAILY_LIMIT="20"
# Quota-gated AI routes stay unavailable unless this is exactly true.
AI_QUOTA_ENABLED="false"
# Required before users can save encrypted DeepSeek API keys.
AI_CREDENTIAL_ENCRYPTION_KEY=""
